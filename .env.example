# Copy to .env and adjust. All variables are OPTIONAL — the server runs without any of
# them (in-memory, single instance). See docs/07.

# Where the HTTP server listens.
LISTEN_ADDR=:8080

# Directory of the web client (defaults to "web" relative to the working directory).
STATIC_DIR=web

# Enable PostgreSQL persistence. Unset => documents are in-memory only.
DATABASE_URL=postgres://collab:collab@localhost:5432/collab

# Enable Redis cross-instance fan-out. Unset => single instance.
REDIS_ADDR=localhost:6379

# Identifies this server process for cross-pod echo suppression. Auto-generated if unset.
# INSTANCE_ID=pod-a
